{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "congress.kadoa.com"
        }
      ],
      "destination": "https://www.kadoa.com/congress/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "congress.kadoa.com"
        }
      ],
      "destination": "https://www.kadoa.com/congress/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/congress/((?!data/|assets/|favicon|robots|sitemap|og-image).*)",
      "destination": "/congress/index.html"
    }
  ]
}
